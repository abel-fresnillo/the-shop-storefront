# Copy to .env and add to .gitignore (never commit secrets)
# VITE_ prefix variables are inlined at build time — do NOT store secrets here
#
# Local dev: Vite proxies /api → localhost:3000 and /orders → localhost:3001,
# so use relative paths. The proxy targets are configured in vite.config.ts.
# Production (Vercel): set full https:// URLs in the Vercel dashboard.
#
# Both local and production use relative paths — proxying is handled by
# Vite (vite.config.ts) in dev and Vercel rewrites (vercel.json) in production.
VITE_PRODUCT_API_URL=/api
VITE_APP_ENV=development
VITE_ORDER_SERVICE_URL=
VITE_ORDER_API_KEY=
VITE_PRODUCT_API_KEY=

# OpenTelemetry — VITE_ vars are embedded in the JS bundle at build time.
# Use a Grafana Cloud service account token with write-only OTLP scope
# (metrics:write, traces:write, logs:write). These values are visible to end
# users in the compiled bundle; that is expected and acceptable for browser OTel.
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-3.grafana.net/otlp
VITE_OTEL_GRAFANA_INSTANCE_ID=
VITE_OTEL_GRAFANA_API_TOKEN=
VITE_OTEL_SERVICE_NAME=the-shop-storefront
