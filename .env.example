# Copy to .env and add to .gitignore (never commit secrets)
# VITE_ prefix variables are inlined at build time — do NOT store secrets here
#
# Local: use localhost URLs. Production (Vercel): set full https:// URLs in the dashboard.
VITE_PRODUCT_API_URL=http://localhost:3000/api
VITE_APP_ENV=development
VITE_ORDER_SERVICE_URL=http://localhost:3001
VITE_ORDER_API_KEY=
VITE_PRODUCT_API_KEY=

# OpenTelemetry — VITE_ vars are embedded in the JS bundle at build time.
# Use a Grafana Cloud service account token with write-only OTLP scope
# (metrics:write, traces:write, logs:write). These values are visible to end
# users in the compiled bundle; that is expected and acceptable for browser OTel.
# Leave blank locally to use the console exporter.
# In production set to /api/otlp — the edge function at api/otlp/v1/[signal].ts
# proxies to Grafana and injects credentials server-side via GRAFANA_INSTANCE_ID
# and GRAFANA_API_TOKEN (non-VITE server-only env vars set in Vercel dashboard).
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=
VITE_OTEL_SERVICE_NAME=the-shop-storefront
